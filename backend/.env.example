# Cấu hình cổng chạy Backend
PORT=5001

# Chế độ Mock dữ liệu thông minh (true: test ngay không cần API key; false: gọi API thật)
USE_MOCK_DATA=true

# API Key cho dịch vụ Reverse Image Search (Tùy chọn khi bật API thật)
SERPAPI_KEY=your_serpapi_key_here
GOOGLE_VISION_API_KEY=your_google_vision_key_here
